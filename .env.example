# Copy this file to smartdoc-ai/.env and fill your own values
# Never commit real API keys.

# Provider keys (first non-empty alias is used)
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=

# Inter-service auth (optional in local dev)
SERVICE_TOKEN=

# Model/runtime config
MODEL_NAME=gemini-2.5-flash
CHUNK_SIZE_WORDS=220
CHUNK_OVERLAP_WORDS=30
RETRIEVAL_TOP_K=5

# Optional: custom .env location override
# SMARTDOC_AI_ENV_FILE=C:\\path\\to\\smartdoc-ai\\.env

